# Public URL of this deployment (scheme + host, no trailing slash). Used for cookies, OAuth/MCP
# metadata and passkeys (the passkey RP ID is this hostname: changing it invalidates passkeys).
ORIGIN=https://dart.example.com
# Hostname for the optional Caddy profile (automatic HTTPS). Must match ORIGIN.
DOMAIN=dart.example.com

# Required. At least 32 random characters: `openssl rand -base64 48`.
# Encrypts TOTP secrets and keys recovery-code hashes; keep it stable and secret.
APP_SECRET=

# Who can create accounts after the first admin: closed | invite | open
REGISTRATION=invite
# Optional fixed token for /setup. If empty, a random one is printed to the server log on first start.
SETUP_TOKEN=

# OpenDART request budgets (per KST day).
AUTO_DAILY_BUDGET=2000
TOTAL_DAILY_CAP=18000

# The OpenDART key is stored encrypted (AES-256-GCM) with a key derived from APP_SECRET and the
# host's hardware ID. Inside Docker the host ID must be mounted: on Linux hosts keep the line below.
# On Docker Desktop (macOS/Windows) remove it: there it binds to the Docker VM's machine-id, which is
# regenerated when Docker Desktop is reset. The key is then encrypted with APP_SECRET only.
COMPOSE_FILE=docker-compose.yml:docker-compose.host-id.yml
# auto (bind to host when an ID is available) | required (refuse to store the key without one) | off
API_KEY_HOST_BINDING=auto

# Show this server's public IP on the admin page (needed for OpenDART's IP allowlist): on | off
EGRESS_IP_LOOKUP=on

# Client IP detection behind a reverse proxy (adapter-node). See README.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Host port mapping for the app container.
APP_BIND=127.0.0.1:3000
