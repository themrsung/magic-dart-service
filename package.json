{
  "name": "magic-dart-service",
  "version": "0.1.1",
  "description": "Self-hosted web app and MCP server over a local cache of OpenDART (Korean electronic disclosure) data, with accounts, passkeys and an English UI.",
  "keywords": [
    "opendart",
    "dart",
    "korea",
    "disclosure",
    "전자공시",
    "mcp",
    "model-context-protocol",
    "sveltekit",
    "self-hosted",
    "k-ifrs"
  ],
  "homepage": "https://github.com/themrsung/magic-dart-service#readme",
  "bugs": {
    "url": "https://github.com/themrsung/magic-dart-service/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themrsung/magic-dart-service.git"
  },
  "author": "Min Jun Sung",
  "license": "MIT",
  "type": "module",
  "bin": {
    "magic-dart-service": "bin/magic-dart-service.js"
  },
  "files": [
    "bin",
    "build",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "node scripts/dev-mock.ts",
    "mock:opendart": "node test/mock-opendart/cli.ts",
    "i18n:report": "node scripts/i18n-report.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "magic-dart": "^0.1.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.28.2": true
  }
}
